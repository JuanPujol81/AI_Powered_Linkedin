NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://linkedin:linkedin@localhost:5432/linkedin_agent?schema=public
REDIS_URL=redis://localhost:6379

# Generate a 32-byte key before storing OAuth tokens.
# Example: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Choose one provider initially. Keep provider-specific calls behind src/modules/ai.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

VITE_API_URL=http://localhost:3000/api

