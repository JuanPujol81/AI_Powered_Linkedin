{
  "name": "ai-powered-linkedin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:web": "npm run dev --workspace web",
    "build": "tsc -p tsconfig.json && npm run build --workspace web",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bullmq": "^5.56.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.32.0",
    "prisma": "^6.13.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
